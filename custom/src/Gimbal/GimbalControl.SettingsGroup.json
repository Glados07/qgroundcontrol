            "type": "bool",
            "default": false
        },
        {
            "name": "forceAndroidH265HardwareDecoder",
            "shortDesc": "Require Android H.264/H.265 hardware decoders",
            "type": "bool",
            "default": true,
            "qgcRebootRequired": true
        },
        {
            "name": "uniRcChannelControlEnabled",
            "shortDesc": "Enable UniRC SDK",
            "type": "bool",
            "default": true
        },
        {
            "name": "uniRcSdkInterface",
            "shortDesc": "UniRC SDK interface",
            "type": "uint32",
            "enumStrings": "Bluetooth",
            "enumValues": "0",
            "default": 0
        },
        {
            "name": "uniRcSdkBluetoothAddress",
            "shortDesc": "UniRC SDK Bluetooth address",
            "type": "string",
            "default": "41:42:9E:3D:A5:D2"
        }
