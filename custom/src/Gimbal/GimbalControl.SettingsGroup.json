{
    "version": 1,
    "fileType": "FactMetaData",
    "QGC.MetaData.Facts": [
        {
            "name": "enabled",
            "shortDesc": "Enable SIYI gimbal camera control",
            "type": "bool",
            "default": true
        },
        {
            "name": "localMediaStorageEnabled",
            "shortDesc": "Save camera photos and videos locally",
            "longDesc": "When enabled, camera photo and recording actions also save media to this device independently of gimbal SD card storage.",
            "type": "bool",
            "default": true
        },
        {
            "name": "sdkHost",
            "shortDesc": "SIYI SDK UDP host",
            "type": "string",
            "default": "192.168.144.25"
        },
        {
            "name": "sdkPort",
            "shortDesc": "SIYI SDK UDP port",
            "type": "uint32",
            "min": 1,
            "max": 65535,
            "default": 37260
        },
        {
            "name": "zoomStep",
            "shortDesc": "Zoom step",
            "type": "double",
            "units": "x",
            "min": 0.1,
            "max": 4.5,
            "decimalPlaces": 1,
            "default": 1.0
        },
        {
            "name": "uniRcZoomDirectionReversed",
            "shortDesc": "Reverse channel gimbal zoom control",
            "type": "bool",
            "default": false
        },
        {
            "name": "mt11Enabled",
            "shortDesc": "Enable UniPod MT11 camera control",
            "type": "bool",
            "default": true
        },
        {
            "name": "mt11SdkHost",
            "shortDesc": "UniPod MT11 SDK UDP host",
            "longDesc": "Controls UniPod MT11 camera commands only. This address is independent of RTSP URL 2 under Video settings.",
            "type": "string",
            "default": "192.168.144.24"
        },
        {
            "name": "mt11SdkPort",
            "shortDesc": "UniPod MT11 SDK UDP port",
            "type": "uint32",
            "min": 1,
            "max": 65535,
            "default": 37260
        },
        {
            "name": "mt11ZoomStep",
            "shortDesc": "UniPod MT11 zoom step",
            "type": "double",
            "units": "x",
            "min": 0.1,
            "max": 29.0,
            "decimalPlaces": 1,
            "default": 1.0
        },
        {
            "name": "mavlinkAutoVideoStream",
