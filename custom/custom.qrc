<RCC>
    <qresource prefix="/custom/img">
        <file alias="dronecode-black.svg">res/Images/dronecode-black.svg</file>
        <file alias="dronecode-white.svg">res/Images/dronecode-white.svg</file>
    </qresource>
    <qresource prefix="/Custom/qmlimages">
        <!-- 物理目录遵循 QGC src；独立资源前缀避免与原生同名资源冲突。 -->
        <file alias="Fuel.svg">src/UI/toolbar/Images/Fuel.svg</file>
        <file alias="PaperPlane.svg">src/UI/toolbar/Images/PaperPlane.svg</file>
        <file alias="Viewer3D/City3DMapIcon.svg">src/Viewer3D/Images/city_3d_map_icon.svg</file>
        <file alias="compass_needle.svg">src/FlightMap/Images/compass_needle.svg</file>
        <file alias="compass_pointer.svg">src/FlightMap/Images/compass_pointer.svg</file>
        <file alias="attitude_crosshair.svg">src/FlightMap/Images/attitude_crosshair.svg</file>
        <file alias="attitude_dial.svg">src/FlightMap/Images/attitude_dial.svg</file>
        <file alias="attitude_pointer.svg">src/FlightMap/Images/attitude_pointer.svg</file>
        <file alias="altitude.svg">src/UI/toolbar/Images/altitude.svg</file>
        <file alias="chronometer.svg">src/UI/toolbar/Images/chronometer.svg</file>
        <file alias="distance.svg">src/UI/toolbar/Images/distance.svg</file>
        <file alias="horizontal_speed.svg">src/UI/toolbar/Images/horizontal_speed.svg</file>
        <file alias="microSD.svg">src/UI/toolbar/Images/microSD.svg</file>
        <file alias="odometer.svg">src/UI/toolbar/Images/odometer.svg</file>
        <file alias="vertical_speed.svg">src/UI/toolbar/Images/vertical_speed.svg</file>
    </qresource>
    <qresource prefix="/Custom/qml">
        <!-- 覆盖文件保持与 QGC 原生 QML 模块相同的相对路径和文件名。 -->
        <file alias="QGroundControl/Controls/AppSettings.qml">src/QmlControls/AppSettings.qml</file>
        <file alias="QGroundControl/Controls/FuelStatusIndicator.qml">src/QmlControls/FuelStatusIndicator.qml</file>
        <file alias="QGroundControl/AppSettings/FlyViewSettings.qml">src/UI/AppSettings/FlyViewSettings.qml</file>
        <file alias="QGroundControl/AppSettings/SettingsPage.qml">../src/UI/AppSettings/SettingsPage.qml</file>
        <file alias="QGroundControl/AppSettings/Viewer3DSettingsGroup.qml">src/UI/AppSettings/Viewer3DSettingsGroup.qml</file>
        <file alias="QGroundControl/AppSettings/GimbalControlSettingsGroup.qml">src/UI/AppSettings/GimbalControlSettingsGroup.qml</file>
        <file alias="QGroundControl/FlightDisplay/FlyView.qml">src/FlightDisplay/FlyView.qml</file>
        <file alias="QGroundControl/FlightDisplay/FlyViewWidgetLayer.qml">src/FlightDisplay/FlyViewWidgetLayer.qml</file>
