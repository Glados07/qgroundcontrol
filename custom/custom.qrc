        <file alias="QGroundControl/FlightDisplay/FlyViewToolStripActionList.qml">src/FlightDisplay/FlyViewToolStripActionList.qml</file>
        <file alias="QGroundControl/FlightDisplay/GimbalZoomControl.qml">src/FlightDisplay/GimbalZoomControl.qml</file>
    </qresource>
    <qresource prefix="/Custom/res">
        <file alias="QGCLogoFull.svg">res/QGCLogoFull.svg</file>
        <file alias="qgroundcontrol.ico">res/icons/custom_qgroundcontrol.ico</file>
    </qresource>
